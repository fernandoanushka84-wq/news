# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=thailand_tourism_news

# Full SQLAlchemy URL (auto built if above are set)
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/thailand_tourism_news

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# App
APP_TITLE=Thailand Tourism News Analyzer
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Scraper
SCRAPE_INTERVAL_MINUTES=60
AUTO_SCRAPE_ON_STARTUP=false